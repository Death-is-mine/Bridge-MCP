{
  "name": "opencode-mcp-bridge",
  "version": "0.1.0",
  "description": "Web-first MCP control plane connecting AI clients to local OpenCode",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
