{
  "name": "bridge-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/bridge",
    "packages/worker"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build -w packages/shared",
    "build:bridge": "npm run build -w packages/bridge",
    "build:worker": "npm run build -w packages/worker",
    "dev:bridge": "npm run dev -w packages/bridge",
    "dev:worker": "npm run dev -w packages/worker",
    "start:bridge": "npm run start -w packages/bridge",
    "start:worker": "npm run start -w packages/worker",
    "test": "npm run test -w packages/bridge",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
